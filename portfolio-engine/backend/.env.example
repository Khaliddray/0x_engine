# Database Configuration
# Accepts postgresql+psycopg://, postgresql://, or postgres:// (auto-normalized)
DATABASE_URL=postgresql+psycopg://portfolio_user:portfolio_password@localhost:5432/portfolio_db

# Security & Authentication
# Generate a secure key using: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Configuration
APP_NAME=Portfolio Engine API
APP_VERSION=0.1.0
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated origins or *)
CORS_ORIGINS=*

# Initial Administrator Seed Credentials (used by scripts/seed_data.py --if-empty)
ADMIN_EMAIL=khalidzak21@gmail.com
ADMIN_PASSWORD=1234567Khalid
ADMIN_NAME=Yahaya Khalid
